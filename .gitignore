media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Eternal (blackletter display font) needs an FG Studios license for this kind of
# use per its recorded terms — not free to redistribute here. Metal Mania (OFL)
# and Trueno Round Bold (OFL) are both genuinely open and stay committed.
# See fonts/README.md in each folder for how to drop your own copy in locally.
frontend/public/fonts/Eternal.ttf
website/fonts/Eternal.ttf

# Coach portraits (public/coaches/README.md) are user-supplied art of unconfirmed license —
# same caution as Eternal above. CoachBubble falls back to a plain avatar when these are absent.
frontend/public/coaches/*.png
